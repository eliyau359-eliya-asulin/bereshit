# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (Atlas or local). Include the database name in
# the path if you want it picked automatically, e.g. ".../mydb?...".
MONGODB_URI=your_mongodb_connection_string

# Only used if MONGODB_URI doesn't already specify a database in its path.
MONGODB_DB_NAME=bereshit

# Comma-separated list of origins allowed to call the API (the ports the
# customer site / admin dashboard are served from during development).
# Must be explicit origins, never "*" — session cookies require it, and
# browsers refuse wildcard-origin + credentials anyway. In production, if
# the frontend and /api/* are served from the same Vercel deployment (the
# default here), this isn't needed at all.
CORS_ORIGINS=http://localhost:8123,http://127.0.0.1:8123

# Flask server
PORT=5000
# Leave unset/false in any deployed environment — debug mode executes
# arbitrary code via the Werkzeug debugger and leaks stack traces.
FLASK_DEBUG=false

# --- Auth ---------------------------------------------------------------

# Signs nothing security-critical today (sessions are opaque random tokens
# looked up in MongoDB, not signed cookies) but Flask expects a secret key
# to exist. Set a real random value in production; a random one is
# generated in-memory if omitted, which is fine for local dev but means
# sessions won't survive a process restart.
SECRET_KEY=

# Cookies default to Secure (HTTPS-only). Set to "false" ONLY for local
# development over plain http:// — never in a deployed environment, or
# session cookies will be sent unencrypted.
COOKIE_SECURE=true

# First Super Admin account, created once automatically at startup if no
# admin_users exist yet. Leave unset to skip bootstrapping (no admin login
# will work until an admin user is created some other way). Never invent
# a value for these — set your own.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Super Admin

# --- Product image storage (Vercel Blob) --------------------------------
#
# Product images are never stored in MongoDB or embedded in the frontend;
# only the resulting URL (from Vercel Blob) is stored on the product
# document. Leave this unset and image upload is simply unavailable
# (returns a clear "not configured" error) rather than pretending to work.
#
# REQUIRES a Blob store created with PUBLIC access (Vercel dashboard ->
# Storage -> Create Database -> Blob -> access: Public). A store created
# as Private cannot serve this app's product images: private blobs
# require an authenticated request for every single read, which is
# unusable for a plain customer-facing <img src>. The store's access mode
# is fixed at creation and cannot be changed afterward — a private store
# must be recreated (or a new public store created alongside it) rather
# than reconfigured.
#
# Store: bereshit-images-public. Once connected to this project (Storage
# tab -> bereshit-images-public -> Connect to Project -> select
# Production/Preview/Development as needed, with the variable prefix set
# to "BERESHIT_IMAGES" under Advanced Options — this is the step that
# adds the variables below, separately from just creating the store),
# Vercel adds these automatically:
BERESHIT_IMAGES_READ_WRITE_TOKEN=
# The store's id (Vercel adds this alongside the token above once the
# store is connected to the project — see above). Used to construct the
# public CDN URL for a blob (https://<BERESHIT_IMAGES_STORE_ID>.public.
# blob.vercel-storage.com/<path>) without a network round-trip; required
# for the server to read back a file the browser just uploaded directly
# to Blob (see api/blob-upload-token.js).
BERESHIT_IMAGES_STORE_ID=
# Vercel also adds this alongside the two above. Not currently used —
# this app's upload flow doesn't rely on Vercel's onUploadCompleted
# webhook (see api/blob-upload-token.js's header comment for why); kept
# here only so `vercel env pull` doesn't silently drop it, and so it's
# ready if a webhook-based flow is ever added later.
BERESHIT_IMAGES_WEBHOOK_PUBLIC_KEY=
#
# For local dev, copy these three values here (or run `vercel env pull`).
# Never hardcode BERESHIT_IMAGES_READ_WRITE_TOKEN anywhere else, and
# never expose it to browser JavaScript — it is a server-only credential
# used exclusively by backend/images/storage.py and
# api/blob-upload-token.js (the latter reads it directly from the
# environment; it is never included in that function's response to the
# browser — only a short-lived, narrowly-scoped presigned upload URL is).
#
# NOTE: an older store's unprefixed BLOB_STORE_ID / BLOB_READ_WRITE_TOKEN
# / BLOB_WEBHOOK_PUBLIC_KEY variables may still exist in this project —
# intentionally not removed yet. Nothing in this codebase reads them any
# more (see the tests in backend/tests/test_images.py asserting exactly
# that); they're safe to delete once you've confirmed the old store is
# no longer needed, but that's a manual decision, not one this app makes.
